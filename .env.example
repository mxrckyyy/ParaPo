# PARA PO — environment variable template (Phase 2+).
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Public values are safe in the browser ONLY because Supabase RLS enforces access.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — public by design, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override map tiles (default is OpenStreetMap standard tiles)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: only if a Mapbox layer is added later
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only. NEVER prefix with NEXT_PUBLIC_, NEVER commit, NEVER import in client code.
# Used only by lib/supabase/admin.ts (Route Handlers / scripts, Phase 2+).
# SUPABASE_SERVICE_ROLE_KEY=
